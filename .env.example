# Google AI Studio API key. Keep this server-side; never prefix it with VITE_.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3-flash-preview
GEMINI_MODEL=gemini-3-flash-preview

# Production SaaS requirements (server-side only):
# DATABASE_URL=postgresql://...
# BETTER_AUTH_SECRET=generate-a-long-random-secret
# BETTER_AUTH_URL=https://your-production-domain.example
# GROK_GATE_ORIGIN=https://your-identity-gateway.example
# VITE_AUTH_ENABLED=true
# Configure the supported identity provider / Gate identity for your deployment.
